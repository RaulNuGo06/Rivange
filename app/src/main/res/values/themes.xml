<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.Rivange" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/rivange_primary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/rivange_primary_dark</item>
        <item name="colorOnPrimaryContainer">@color/white</item>

        <item name="colorSecondary">@color/rivange_secondary</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorSecondaryContainer">@color/rivange_secondary_dark</item>
        <item name="colorOnSecondaryContainer">@color/white</item>

        <item name="android:statusBarColor">@color/background_main</item>
        <item name="android:navigationBarColor">@color/background_main</item>
        <item name="android:windowBackground">@color/background_main</item>

        <item name="colorSurface">@color/background_surface</item>
        <item name="colorOnSurface">@color/text_primary</item>

        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>

        <item name="materialCardViewStyle">@style/Widget.Rivange.Card</item>
        <item name="buttonStyle">@style/Widget.Rivange.Button</item>
    </style>

    <style name="Theme.Rivange.Splash" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowBackground">@drawable/bg_splash</item>
        <item name="android:statusBarColor">@color/background_main</item>
        <item name="android:navigationBarColor">@color/background_main</item>
    </style>

    <style name="Widget.Rivange.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">@color/background_surface</item>
        <item name="strokeColor">@color/stroke_soft</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardCornerRadius">20dp</item>
        <item name="cardElevation">4dp</item>
    </style>

    <style name="Widget.Rivange.Button" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/rivange_primary</item>
        <item name="android:textColor">@color/white</item>
        <item name="cornerRadius">16dp</item>
    </style>

</resources>